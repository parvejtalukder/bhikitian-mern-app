# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server-only MediaWiki origin (no trailing slash).
MEDIAWIKI_BASE_URL="https://your-mediawiki-origin.example"

# Public canonical domain for the headless frontend
PUBLIC_SITE_URL="https://en.bhikitia.org"

# Proposed staff-only MediaWiki editor origin (excluded from search indexing)
STAFF_MEDIAWIKI_URL="https://your-editor-origin.example"

# Editorial staff console passcode (/submit/admin)
ADMIN_PASSCODE="replace-with-a-long-random-staff-secret"

# Shared secret for MediaWiki webhook -> POST /api/revalidate cache purges
REVALIDATION_SECRET="replace-with-a-long-random-webhook-secret"

# Public WhatsApp & Editorial Contact used for follow-up links
WHATSAPP_DESK_NUMBER="replace-with-staff-number"
EDITORIAL_EMAIL="replace-with-editorial-address"

# ---------------------------------------------------------------------------
# Performance / resilience tuning (all optional, all clamped to safe ranges).
# See docs/performance-report.md for the design these knobs drive.
# ---------------------------------------------------------------------------

# Edition/language namespace for cache keys and purge tags.
# Defaults to the MediaWiki hostname's first label (en.bhikitia.org -> "en").
MEDIAWIKI_EDITION="en"
MEDIAWIKI_LANG="en"

# Fresh cache windows (ms). Article default 60s matches `revalidate` in
# src/app/wiki/[...slug]/page.tsx - keep them in step.
MEDIAWIKI_ARTICLE_TTL_MS="60000"
MEDIAWIKI_SEARCH_TTL_MS="60000"
MEDIAWIKI_PORTAL_TTL_MS="60000"
MEDIAWIKI_SITEMAP_TTL_MS="1800000"
MEDIAWIKI_MISSING_TTL_MS="60000"
MEDIAWIKI_TOMBSTONE_TTL_MS="600000"

# How long the last successful payload may still be served while MediaWiki is
# degraded (stale-if-error). Kept in step with `expireTime` in next.config.ts.
MEDIAWIKI_ARTICLE_STALE_MS="86400000"
MEDIAWIKI_SEARCH_STALE_MS="300000"
MEDIAWIKI_PORTAL_STALE_MS="86400000"
MEDIAWIKI_SITEMAP_STALE_MS="86400000"

# Upstream timeouts (ms). No retries are performed by design.
MEDIAWIKI_TIMEOUT_MS="8000"
MEDIAWIKI_SEARCH_TIMEOUT_MS="3500"

# Per-replica upstream concurrency budgets. Divide by the replica count when
# scaling horizontally.
MEDIAWIKI_MAX_CONCURRENCY="8"
MEDIAWIKI_SEARCH_CONCURRENCY="4"
MEDIAWIKI_QUEUE_LIMIT="200"
MEDIAWIKI_QUEUE_WAIT_MS="2000"

# Circuit breaker: consecutive failures before it opens, and how long it stays
# open (fail fast) so an outage is not amplified.
MEDIAWIKI_CIRCUIT_FAILURES="5"
MEDIAWIKI_CIRCUIT_OPEN_MS="10000"

# Bounded cache sizes (LRU).
MEDIAWIKI_ARTICLE_CACHE_MAX="1000"
MEDIAWIKI_SEARCH_CACHE_MAX="300"
MEDIAWIKI_TOMBSTONE_CACHE_MAX="2000"

