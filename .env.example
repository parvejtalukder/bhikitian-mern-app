# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server-only MediaWiki origin (no trailing slash).
# Currently pointed at live MediaWiki 1.44.0 on en.bhikitia.org.
# After staff cutover, point this to https://edit.bhikitia.org so all MediaWiki
# reads, parses, and image proxies swap via configuration alone.
MEDIAWIKI_BASE_URL="https://en.bhikitia.org"

# Public canonical domain for the headless frontend
PUBLIC_SITE_URL="https://en.bhikitia.org"

# Proposed staff-only MediaWiki editor origin (excluded from search indexing)
STAFF_MEDIAWIKI_URL="https://edit.bhikitia.org"

# Editorial staff console passcode (/submit/admin)
ADMIN_PASSCODE="bhikitia-staff-2026"

# Shared secret for MediaWiki webhook -> POST /api/revalidate cache purges
REVALIDATION_SECRET="bhikitia-revalidate-secret"

# Public WhatsApp & Editorial Contact used for follow-up links
WHATSAPP_DESK_NUMBER="8801700000000"
EDITORIAL_EMAIL="editorial@bhikitia.org"
